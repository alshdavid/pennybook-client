{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["DOM", "ESNext", "ESNext.AsyncIterable", "ESNext.Array"],
    "strict": true,
    "noEmit": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "jsx": "react",
    "jsxFactory": "h",
    "types": [
      "./.config/typings/pb-worker.d.ts",
      "./.config/typings/modules.d.ts",
    ]
  },
  "include": ["src/**/*", "worker/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
